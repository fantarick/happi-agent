{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Happi Agent validation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "max_files",
    "max_diff_bytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "max_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_diff_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 104857600
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_binary_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
